FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Optimized heavy image with the same language/runtime tooling but smaller footprint.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       build-essential clang cmake git python3 python3-pip openjdk-17-jdk-headless nodejs npm \
       ruby ruby-dev wget curl ca-certificates fontconfig locales sudo \
       golang-go \
    && locale-gen en_US.UTF-8 \
    && pip3 install --no-cache-dir numpy pandas requests \
    && npm install -g yarn webpack || true \
    && gem install bundler || true \
    && useradd -m builder || true \
    && mkdir -p /opt/workspace /var/log/myapp \
    && apt-get autoremove -y \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /usr/share/doc/* /usr/share/man/* /usr/share/locale/* /var/cache/apt/*

COPY src /opt/workspace/src

WORKDIR /opt/workspace

RUN chmod -R 755 /opt/workspace || true

EXPOSE 8080

CMD ["/bin/bash"]
