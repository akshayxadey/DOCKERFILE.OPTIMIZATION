FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Intentionally heavy image for later optimization exercises
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       build-essential clang cmake git python3 python3-pip openjdk-17-jdk nodejs npm \
       ruby-full golang-go wget curl ca-certificates fontconfig locales sudo \
    && locale-gen en_US.UTF-8 \
    && pip3 install --no-cache-dir numpy pandas requests \
    && npm install -g yarn webpack || true \
    && gem install bundler || true \
    && useradd -m builder || true \
    && mkdir -p /opt/workspace /var/log/myapp \
    && dd if=/dev/zero of=/opt/largefile bs=1M count=100 || true \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY src /opt/workspace/src

WORKDIR /opt/workspace

RUN chmod -R 755 /opt/workspace || true

EXPOSE 8080

CMD ["/bin/bash"]
